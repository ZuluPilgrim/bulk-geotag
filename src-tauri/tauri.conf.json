{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulk GeoTag",
  "version": "1.3.0",
  "identifier": "com.zulupilgrim.bulkgeotag",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Bulk GeoTag",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "Add GPS location and date taken to photos, in bulk or one at a time",
    "longDescription": "Bulk GeoTag writes GPS coordinates and an optional date taken into the EXIF data of JPEG, TIFF and WebP photos. Pick a place by search (OpenStreetMap) or on the map, preview the changes, and apply them to a whole folder or a single photo, with optional backups and a CSV log.",
    "publisher": "André Basel",
    "copyright": "© 2026 André Basel",
    "homepage": "https://github.com/ZuluPilgrim/bulk-geotag"
  },
  "mainBinaryName": "bulk-geotag"
}
